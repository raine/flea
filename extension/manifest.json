{
  "manifest_version": 3,
  "name": "Flea Bridge",
  "version": "0.1.0",
  "description": "Connect Flea to your signed-in Vinted tab without Chrome debugging.",
  "key": "",
  "minimum_chrome_version": "105",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.fi/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}